<div class="ontario-row calendar-header">
    <div class="ontario-column ontario-small-12 medium-7">        
                                <h1><strong>{{ "calendarHeader.title" | localeString }}</strong></h1>
                               
            
    </div>
    <div class="ontario-column ontario-small-12 ontario-medium-8 ontario-large-9">
                                <p class="lead fw-normal text-black-50 mb-4">{{ "calendarHeader.description" | localeString }}</p>
                                <p class="lead fw-normal text-black-50 mb-4">{{ "calendarHeader.ontariostradeteam" | localeString | safe }}</p>                         
                                </div>
    <div class="ontario-column ontario-small-12 ontario-medium-4 ontario-large-3">
        <img src="{{ globals.siteRoot }}{{ globals.designSystemRoot }}/logos/calendarv2.png" alt="" width="240" height="155" />
    </div>
</div>